# Copiá este archivo a .env y completá los valores.
PORT=3000
DATABASE_URL=postgresql://carga24:carga24@localhost:5432/carga24
# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173
# Clave para cifrar los secretos de 2FA (32 bytes en base64): openssl rand -base64 32
CLAVE_CIFRADO=
# Carpeta de comprobantes (por defecto ./archivos)
DIRECTORIO_ARCHIVOS=archivos

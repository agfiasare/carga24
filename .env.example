# Variables del servidor (docker-compose.yml). Copiá a .env y completá.
# Nunca subas el archivo .env al repositorio.

# Dominio principal (sin https://). Se usan también panel.<dominio> y api.<dominio>.
DOMINIO=carga24.com.ar
# Email para los avisos de vencimiento de certificados HTTPS.
EMAIL_CERTIFICADOS=

POSTGRES_USER=carga24
# Contraseña larga y aleatoria.
POSTGRES_PASSWORD=
POSTGRES_DB=carga24

# Días que se guardan los backups en el VPS (además de la copia externa).
RETENCION_DIAS=14

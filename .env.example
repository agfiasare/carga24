# Variables del servidor. Copiá este archivo a .env y completalo (ver deploy/README.md).
# Nunca subas el archivo .env al repositorio.

# Dominio principal (sin https://). La web usa también www.<dominio> y panel.<dominio>.
DOMINIO=carga24.com.ar

# tunel  = Cloudflare Tunnel (recomendado): el servidor no abre puertos web.
# directo = sin Cloudflare: Caddy saca los certificados de Let's Encrypt.
MODO=tunel
# En modo tunel: http://   ·   En modo directo: dejalo vacío.
ESQUEMA=http://
# Modo tunel: el token que da Cloudflare al crear el túnel (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=
# Modo directo: email para los avisos de Let's Encrypt.
EMAIL_CERTIFICADOS=

POSTGRES_USER=carga24
POSTGRES_DB=carga24
# Si lo dejás vacío, "deploy/carga24.sh instalar" genera una contraseña larga.
POSTGRES_PASSWORD=

# Cifra los secretos de 2FA del staff (32 bytes en base64). Si lo dejás vacío se genera.
# GUARDALA FUERA DEL SERVIDOR: si se pierde, todo el staff tiene que reconfigurar el 2FA.
CLAVE_CIFRADO=

# Días que se guardan los backups en el VPS.
RETENCION_DIAS=14

# Copia de los backups fuera del servidor (muy recomendado). Ejemplo con Cloudflare R2:
#   COPIA_EXTERNA=externa:carga24-backups   (externa:<nombre-del-bucket>)
#   COPIA_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
COPIA_EXTERNA=
COPIA_PROVEEDOR=Cloudflare
COPIA_ENDPOINT=
COPIA_ACCESS_KEY_ID=
COPIA_SECRET_ACCESS_KEY=
